# ============================================================================
# Flask Configuration
# ============================================================================

# Secret key for session encryption (generate a strong random string in production)
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode (set to False in production)
DEBUG=False

# Flask environment (development, production, testing)
FLASK_ENV=development

# Application host and port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ============================================================================
# Database Configuration
# ============================================================================

# Database path (relative to Raktsetu directory)
DATABASE_PATH=blood_finder.db

# ============================================================================
# Mobile App Backend URL (for CORS if needed in the future)
# ============================================================================

# Set this to your local IP address when running on physical devices
# Example: http://192.168.1.15:5000
# For emulator, the mobile app uses http://10.0.2.2:5000 by default
